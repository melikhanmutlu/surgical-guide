{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "superpowers-marketplace": { "source": { "source": "github", "repo": "obra/superpowers-marketplace" } },
    "caveman": { "source": { "source": "github", "repo": "JuliusBrussee/caveman" } },
    "claude-hud": { "source": { "source": "github", "repo": "jarrodwatts/claude-hud" } },
    "last30days-skill": { "source": { "source": "github", "repo": "mvanhorn/last30days-skill" } },
    "impeccable": { "source": { "source": "github", "repo": "pbakaus/impeccable" } },
    "ui-ux-pro-max-skill": { "source": { "source": "github", "repo": "nextlevelbuilder/ui-ux-pro-max-skill" } },
    "taste-skill": { "source": { "source": "github", "repo": "Leonxlnx/taste-skill" } },
    "humanizer": { "source": { "source": "github", "repo": "blader/humanizer" } }
  },
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "caveman@caveman": true,
    "claude-hud@claude-hud": true,
    "last30days@last30days-skill": true,
    "impeccable@impeccable": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "taste-skill@taste-skill": true,
    "humanizer@humanizer": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/gstack-install.sh\"", "timeout": 600 }
        ]
      }
    ]
  }
}
